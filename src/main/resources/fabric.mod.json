{
	"schemaVersion": 1,
	"id": "twiw",
	"version": "${version}",
	"name": "Twitch Chat In World",
	"description": "Adds Twitch Chat messages as flying sprites in world. Supports Emotes!",
	"authors": [
		{
			"name": "Just_S",
			"contact": {
				"homepage": "https://www.youtube.com/@JustS_js"
			}
		}
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/twiw",
		"sources": "https://github.com/JustS-js/TwitchChatInWorld"
	},
	"license": "MIT",
	"icon": "assets/twiw/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"justs_js.twiw.TWIWModClient"
		]
	},
	"mixins": [
		{
			"config": "twiw.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.2",
		"minecraft": ">=1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}